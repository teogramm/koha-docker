# Base de datos
MYSQL_SERVER=db
DB_NAME=koha_teolib
MYSQL_USER=koha_teolib
MYSQL_PASSWORD=example

# Formato MARC para Zebra (aunque no lo uses, es obligatorio)
ZEBRA_MARC_FORMAT=marc21

# Idiomas (opcional, por defecto solo inglés)
# KOHA_LANGS=es

# Elasticsearch
USE_ELASTICSEARCH=true
ELASTICSEARCH_HOST=elasticsearch:9200
OVERRIDE_SYSPREF_SearchEngine=Elasticsearch

# Memcached (muy importante para evitar esos errores)
MEMCACHED_SERVERS=memcached:11211

# Z39.50 (opcional)
USE_Z3950=1

